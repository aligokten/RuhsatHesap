<?xml version="1.0" encoding="utf-8"?>
<!--
  AutoCAD ApplicationPlugins tanımı. Bu klasör RuhsatHesap.bundle adıyla
  %APPDATA%\Autodesk\ApplicationPlugins altına kopyalandığında eklenti her
  AutoCAD oturumunda kendiliğinden yüklenir; NETLOAD gerekmez.
-->
<ApplicationPackage SchemaVersion="1.0"
                    AppVersion="0.6.0"
                    ProductCode="{3B1F4A62-9D74-4F0E-9E3B-7A2C4D915E11}"
                    Name="Ruhsat Hesap"
                    Description="Mimari ruhsat projeleri için polyline alan hesabı, emsal ve ruhsat tabloları"
                    Author="Ali Gökten"
                    ProductType="Application">

  <CompanyDetails Name="Ali Gökten" />

  <Components Description="AutoCAD 2019-2024 (.NET Framework 4.8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R23.0" SeriesMax="R24.3" />
    <ComponentEntry AppName="RuhsatHesap"
                    Version="0.6.0"
                    ModuleName="./Contents/net48/RuhsatHesap.Acad.dll"
                    AppType=".Net"
                    LoadOnAutoCADStartup="True"
                    LoadOnCommandInvocation="False" />
  </Components>

  <Components Description="AutoCAD 2025 ve sonrası (.NET 8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" />
    <ComponentEntry AppName="RuhsatHesap"
                    Version="0.6.0"
                    ModuleName="./Contents/net8.0-windows/RuhsatHesap.Acad.dll"
                    AppType=".Net"
                    LoadOnAutoCADStartup="True"
                    LoadOnCommandInvocation="False" />
  </Components>

</ApplicationPackage>
